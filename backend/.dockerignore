# backend/.dockerignore
#
# Исключения для сборки Docker-образа backend.
# Уменьшает размер образа, ускоряет сборку, защищает секреты.

# ==========================================
# КРИТИЧНО: секреты
# ==========================================
.env
.env.*
!.env.example
*.key
*.pem

# ==========================================
# Виртуальные окружения
# ==========================================
.venv/
venv/
env/
ENV/

# ==========================================
# Python-кэш
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ==========================================
# Тесты (не нужны в prod-образе)
# ==========================================
tests/
pytest.ini
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# ==========================================
# Локальные данные и логи
# ==========================================
*.log
*.sqlite
*.db
data/
tmp/
logs/

# ==========================================
# IDE и OS
# ==========================================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ==========================================
# Git
# ==========================================
.git/
.gitignore
.gitattributes

# ==========================================
# Документация
# ==========================================
*.md
!README.md
docs/

# ==========================================
# Не нужны в образе
# ==========================================
legacy/

# ==========================================
# Docker
# ==========================================
Dockerfile
.dockerignore
docker-compose*.yml