# .env.example
#
# Шаблон переменных окружения для production (docker-compose.prod.yml).
#
# Использование:
#   1. Скопируйте этот файл в .env:  cp .env.example .env
#   2. Заполните значения (особенно SECRET_KEY, POSTGRES_PASSWORD, ALLOWED_ORIGINS).
#   3. .env НЕ коммитится в git (уже в .gitignore).
#
# ⚠️  Файл читается docker compose из КОРНЯ проекта.
#     Не путать с backend/.env — тот для локальной разработки.
#
# ⚠️  При изменении VITE_API_URL — пересобрать frontend:
#     docker compose -f docker-compose.prod.yml build frontend
#     (Vite вшивает переменную в бандл на этапе сборки)

# ==========================================
# POSTGRESQL
# ==========================================
# Обязательные. Используются для создания контейнера БД и подключения backend.
# В production используйте СИЛЬНЫЙ пароль (мин. 16 символов).
# Сгенерировать: openssl rand -base64 24
POSTGRES_USER=aps
POSTGRES_PASSWORD=change_me_strong_password_min_16_chars
POSTGRES_DB=household

# ==========================================
# BACKEND — БД (DATABASE_URL)
# ==========================================
# ⚠️  НЕ задавайте DATABASE_URL в этом файле!
#     В docker-compose.prod.yml он собирается автоматически из
#     POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB с хостом `postgres`.
#
# Для локальной разработки (без Docker) — DATABASE_URL в backend/.env.
#
# Пример для справки:
# DATABASE_URL=postgresql+asyncpg://aps:secret@postgres:5432/household

# ==========================================
# JWT АВТОРИЗАЦИЯ
# ==========================================
# Секретный ключ для подписи JWT.
# ОБЯЗАТЕЛЬНО заменить! Дефолт в config.py небезопасен.
# Минимум 32 символа (валидатор в config.py).
# Сгенерировать: openssl rand -hex 32
SECRET_KEY=change_me_openssl_rand_hex_32_this_is_not_secure_for_production

# Алгоритм подписи. Оставить HS256, если не используете асимметричные ключи.
ALGORITHM=HS256

# Время жизни токена (минуты).
# 1440 = 24 часа (удобно для теста пользователем).
# 60-480 = типично для production.
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==========================================
# CORS — РАЗРЕШЁННЫЕ ИСТОЧНИКИ
# ==========================================
# Обязательно. Frontend не сможет достучаться до API, если домен/IP не в списке.
# Через запятую, БЕЗ пробелов.
#
# Примеры:
#   - IP-адрес:           ALLOWED_ORIGINS=http://192.168.1.100
#   - Домен (HTTPS):      ALLOWED_ORIGINS=https://aps.example.com
#   - Несколько:          ALLOWED_ORIGINS=https://aps.example.com,http://192.168.1.100
#   - Локально (dev):     ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
ALLOWED_ORIGINS=http://your-server-ip,https://your-domain.com

# ==========================================
# FRONTEND — URL API
# ==========================================
# ⚠️  КРИТИЧНО: вшивается в JS-бандл на этапе сборки frontend.
#     После изменения — пересобрать frontend:
#       docker compose -f docker-compose.prod.yml build frontend
#
# Должен совпадать с адресом, по которому пользователь открывает приложение:
#   - Если по IP:        VITE_API_URL=http://192.168.1.100
#   - Если по домену:    VITE_API_URL=https://aps.example.com
#
# НЕ добавляйте слэш на конце (`/`) — frontend сам подставляет `/api/v1/...`.
VITE_API_URL=http://your-server-ip

# ==========================================
# ОРГАНИЗАЦИЯ ПО УМОЛЧАНИЮ
# ==========================================
# ID тенанта для демо-данных. Совпадает с тем, что в init_schema_v4.9.sql.
# Менять только если вы кастомизируете seed-данные.
DEFAULT_ORG_ID=00000000-0000-0000-0000-000000000001

# ==========================================
# МЕТАДАННЫЕ ПРИЛОЖЕНИЯ
# ==========================================
APP_NAME=APS Production Scheduler
APP_VERSION=4.9.0

# Режим отладки.
# false — production (обычные логи, безопасные ошибки).
# true  — debug (SQL echo, трейсбэки в ответах).
DEBUG=false

# ==========================================
# ГЕНЕРАЦИЯ СЕКРЕТОВ (СПРАВКА)
# ==========================================
# SECRET_KEY (hex, 64 символа):
#   openssl rand -hex 32
#
# POSTGRES_PASSWORD (base64, ~32 символа):
#   openssl rand -base64 24
#
# В Windows PowerShell:
#   [Convert]::ToHexString((1..32 | ForEach-Object { Get-Random -Maximum 256 })).ToLower()